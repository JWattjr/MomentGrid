# Leave unset to run entirely in the browser with no API and no wallet.
NEXT_PUBLIC_API_URL=

NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Printed by the deploy script.
NEXT_PUBLIC_MOMENT_GRID_ADDRESS=
NEXT_PUBLIC_INCO_GRID_STORE_ADDRESS=

# The ERC20 the pot is denominated in. Circle's USDC on Base Sepolia, six
# decimals. Must match ENTRY_TOKEN_ADDRESS in api/.env.
NEXT_PUBLIC_ENTRY_TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_ENTRY_TOKEN_SYMBOL=USDC
NEXT_PUBLIC_ENTRY_TOKEN_DECIMALS=6

# Where transaction links point.
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.basescan.org

# Guest-mode fallback. When the API is running, the round is fetched at runtime
# from GET /rounds/current and this value is ignored.
NEXT_PUBLIC_ROUND_ID=1

NEXT_PUBLIC_REPLAY_SECONDS=120
